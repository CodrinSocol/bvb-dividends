# Copy to .env for local development. The service this replaces committed its
# database password to the repository; this file is the example, and .env is
# git-ignored.

# --- database ---
POSTGRES_DB=bvb_dividends
POSTGRES_USER=bvb_dividends
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5555
DATABASE_URL=postgres://bvb_dividends:local-development-only@localhost:5555/bvb_dividends?sslmode=disable

# Apply pending migrations on startup. Leave on for local development; deploy
# with this off and run `nx run postgres:migrate-up` as a release step.
DB_AUTO_MIGRATE=true

# The integration tests TRUNCATE between cases, so they run against their own
# database and refuse to start unless its name contains "test".
TEST_DATABASE_URL=postgres://bvb_dividends:local-development-only@localhost:5555/bvb_dividends_test?sslmode=disable

# --- api ---
API_ADDR=:8080
API_CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- importer ---
# The BVB SOAP endpoint. Reachable only from networks that allow ws.bvb.ro.
BVB_ENDPOINT=https://ws.bvb.ro/BVBFinancialsWS/Financials.asmx
BVB_TIMEOUT=30s

# Log level: debug, info, warn or error.
LOG_LEVEL=info
LOG_FORMAT=json

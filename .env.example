# Copy to .env for local development. The service this replaces committed its
# database password to the repository; this file is the example, and .env is
# git-ignored.

# --- database ---
# docker-compose.yml reads POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD and
# POSTGRES_PORT too, so one set of values configures both the container and the
# service that connects to it.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bvb_dividends
POSTGRES_USER=bvb_dividends
POSTGRES_PASSWORD=local-development-only
POSTGRES_SSLMODE=disable

# Apply each slice's schema on startup, in dependency order. Leave on for local
# development; deploy with this off and run `bvb-dividends migrate` as a release
# step.
POSTGRES_MIGRATIONS_APPLY=true

# The integration tests TRUNCATE between cases, so they run against their own
# database and refuse to start unless its name contains "test".
TEST_DATABASE_URL=postgres://bvb_dividends:local-development-only@localhost:5432/bvb_dividends_test?sslmode=disable

# --- http ---
HTTP_SERVER_HOST=
HTTP_SERVER_PORT=8080

# --- BVB ---
# The BVB SOAP endpoint. Reachable only from networks that allow ws.bvb.ro.
BVB_ENDPOINT=https://ws.bvb.ro/BVBFinancialsWS/Financials.asmx
BVB_TIMEOUT=30s
BVB_ATTEMPTS=3

# --- the scheduled import ---
# Turn the schedule off to run `bvb-dividends import` from a cron entry or a
# Kubernetes CronJob instead.
IMPORT_SCHEDULE_ENABLED=true
IMPORT_HOUR=12
IMPORT_TIMEZONE=Europe/Bucharest
IMPORT_RUN_AT_START=false
IMPORT_CONCURRENCY=4

# --- logging ---
# Level: debug, info, warn or error. Format: json or text.
LOG_LEVEL=info
LOG_FORMAT=json

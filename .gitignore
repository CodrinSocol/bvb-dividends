# Node / Bun
node_modules/
*.tsbuildinfo

# Nx
.nx/cache
.nx/workspace-data

# Go
*.test
*.out
/coverage/

# Local environment
.env
.env.local

# Editors
.idea/
.vscode/
.DS_Store

# The web build. The directory itself is committed, with only a placeholder in
# it, because the Go binary embeds it and go:embed fails on a directory that
# does not exist; what vite writes into it is not committed.
/web/dist/*
!/web/dist/.gitkeep

# Go build output. `go build ./...` writes an executable named after the
# package into the working directory; the Nx target for cmd/bvb-dividends
# writes it under the workspace-root dist/ instead.
/bvb-dividends
/bvb-dividends.exe
/dist/

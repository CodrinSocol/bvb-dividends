{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "genproto",
  "projectType": "library",
  "sourceRoot": "libs/genproto",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go build ./libs/genproto/...",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "@nx-go/nx-go:test",
      "options": { "race": true }
    },
    "lint": {
      "executor": "@nx-go/nx-go:lint",
      "options": { "linter": "golangci-lint" }
    }
  },
  "tags": ["lang:go", "type:lib"]
}

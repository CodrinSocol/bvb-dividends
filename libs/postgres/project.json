{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "postgres",
  "projectType": "library",
  "sourceRoot": "libs/postgres",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go build ./libs/postgres/...",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "@nx-go/nx-go:test",
      "options": {
        "race": true
      }
    },
    "lint": {
      "executor": "@nx-go/nx-go:lint",
      "options": {
        "linter": "golangci-lint",
        "args": [
          "run"
        ]
      }
    },
    "migrate-up": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "proto:tools"
      ],
      "options": {
        "command": "./scripts/migrate.sh up",
        "cwd": "{workspaceRoot}"
      }
    },
    "migrate-down": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "proto:tools"
      ],
      "options": {
        "command": "./scripts/migrate.sh down",
        "cwd": "{workspaceRoot}"
      }
    },
    "migrate-status": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "proto:tools"
      ],
      "options": {
        "command": "./scripts/migrate.sh status",
        "cwd": "{workspaceRoot}"
      }
    },
    "migrate-create": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "proto:tools"
      ],
      "options": {
        "command": "./scripts/migrate.sh create {args.name} sql",
        "cwd": "{workspaceRoot}"
      }
    },
    "sqlc-generate": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "proto:tools"
      ],
      "options": {
        "command": ".bin/sqlc generate",
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "{projectRoot}/queries/**/*.sql",
        "{projectRoot}/migrations/**/*.sql",
        "{workspaceRoot}/sqlc.yaml"
      ],
      "outputs": [
        "{workspaceRoot}/libs/postgres/sqlcgen"
      ],
      "cache": true
    },
    "check-generated": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "sqlc-generate"
      ],
      "options": {
        "command": "git diff --exit-code -- libs/postgres/sqlcgen",
        "cwd": "{workspaceRoot}"
      }
    },
    "sqlc-vet": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "proto:tools"
      ],
      "options": {
        "command": ".bin/sqlc vet",
        "cwd": "{workspaceRoot}"
      }
    }
  },
  "tags": [
    "lang:go",
    "type:lib"
  ]
}

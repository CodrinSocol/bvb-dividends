<?xml version="1.0" encoding="utf-8"?>
<!--
  A recorded-shape GetDividends response for one company.

  The three entries cover the states a dividend passes through: fully scheduled
  and paid, announced with no dates or amounts settled yet, and one where BVB
  reported a value in a form that cannot be read. None of them may cost the
  others their import.
-->
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <soap:Body>
    <GetDividendsResponse xmlns="http://www.bvb.ro/">
      <GetDividendsResult>
        <Dividends>
          <DividendInfo>
            <Year>2024</Year>
            <DividendForNaturalPersons>0.0345</DividendForNaturalPersons>
            <DividendForLegalPersons>0.0345</DividendForLegalPersons>
            <DividendsTotal>2085123456.7890</DividendsTotal>
            <DividendType>cash</DividendType>
            <ReferenceDateForGMS>2025-03-14T00:00:00</ReferenceDateForGMS>
            <GMSDate>2025-04-24T00:00:00</GMSDate>
            <RecordDate>2025-06-11T00:00:00</RecordDate>
            <ExDividendDate>2025-06-10T00:00:00</ExDividendDate>
            <AnnouncementDate>2025-03-01T00:00:00</AnnouncementDate>
            <StartPaymentDate>2025-06-25T00:00:00</StartPaymentDate>
            <EndPaymentDate>2025-12-31T00:00:00</EndPaymentDate>
            <MethodOfDividendDistribution>Bank transfer / Depozitarul Central</MethodOfDividendDistribution>
          </DividendInfo>
          <DividendInfo>
            <Year>2025</Year>
            <DividendType>cash</DividendType>
            <AnnouncementDate>2026-02-18T00:00:00</AnnouncementDate>
            <MethodOfDividendDistribution></MethodOfDividendDistribution>
          </DividendInfo>
          <DividendInfo>
            <Year>2023</Year>
            <DividendForNaturalPersons>not reported</DividendForNaturalPersons>
            <DividendsTotal>1500000</DividendsTotal>
            <DividendType>stock</DividendType>
            <ExDividendDate>11/06/2024</ExDividendDate>
            <RecordDate>2024-06-12T00:00:00</RecordDate>
            <MethodOfDividendDistribution>Share allotment</MethodOfDividendDistribution>
          </DividendInfo>
        </Dividends>
      </GetDividendsResult>
    </GetDividendsResponse>
  </soap:Body>
</soap:Envelope>

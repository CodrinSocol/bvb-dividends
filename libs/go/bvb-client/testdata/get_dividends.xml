            <DividendsTotal>2766638017.3800</DividendsTotal>
            <DividendType>gross</DividendType>
            <ReferenceDateForGMS xsi:nil="true" />
            <GMS_Date>2025-04-24T00:00:00</GMS_Date>
            <RecordDate>2025-05-13T00:00:00</RecordDate>
            <ExDividendDate>2025-05-12T00:00:00</ExDividendDate>
            <AnnouncementDate>2025-02-04T00:00:00</AnnouncementDate>
            <StartPaymentDate>2025-06-03T00:00:00</StartPaymentDate>

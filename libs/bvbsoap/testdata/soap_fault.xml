<?xml version="1.0" encoding="utf-8"?>
<!-- What BVB returns when it understands the request and refuses it. -->
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Body>
    <soap:Fault>
      <faultcode>soap:Server</faultcode>
      <faultstring>Server was unable to process request. ---&gt; Invalid identity type.</faultstring>
      <detail />
    </soap:Fault>
  </soap:Body>
</soap:Envelope>

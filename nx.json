{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "cli": {
    "packageManager": "bun"
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/go.mod",
      "{workspaceRoot}/go.sum",
      "{workspaceRoot}/go.work",
      "{workspaceRoot}/tools/go.mod",
      "{workspaceRoot}/.golangci.yml"
    ],
    "go": [
      "{workspaceRoot}/**/*.go",
      "sharedGlobals"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "cache": true
    },
    "test": {
      "inputs": [
        "go",
        "^go"
      ],
      "cache": true
    },
    "lint": {
      "dependsOn": [
        "lint:*"
      ]
    }
  },
  "defaultBase": "main",
  "analytics": false
}
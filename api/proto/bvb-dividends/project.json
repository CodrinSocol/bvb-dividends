{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "proto",
  "projectType": "library",
  "sourceRoot": "api/proto/bvb-dividends",
  "targets": {
    "lint:proto:buf": {
      "executor": "nx:run-commands",
      "options": { "cwd": "{workspaceRoot}", "command": "go tool buf lint" },
      "inputs": ["{projectRoot}/**/*.proto", "{workspaceRoot}/buf.yaml", "{workspaceRoot}/buf.lock"],
      "cache": true
    },
    "lint:proto:api": {
      "executor": "nx:run-commands",
      "options": { "cwd": "{workspaceRoot}", "command": "bash ./scripts/api-lint.sh" },
      "inputs": [
        "{projectRoot}/**/*.proto",
        "{workspaceRoot}/buf.yaml",
        "{workspaceRoot}/buf.lock",
        "{workspaceRoot}/api-linter.yaml"
      ],
      "cache": true
    },
    "lint:proto": {
      "executor": "nx:noop",
      "dependsOn": ["lint:proto:buf", "lint:proto:api"]
    },
    "breaking": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "go tool buf breaking --against '.git#branch=main'"
      }
    },
    "build:proto": {
      "executor": "nx:run-commands",
      "options": { "cwd": "{workspaceRoot}", "command": "go tool buf generate" },
      "inputs": [
        "{projectRoot}/**/*.proto",
        "{workspaceRoot}/buf.gen.yaml",
        "{workspaceRoot}/buf.yaml",
        "{workspaceRoot}/buf.lock"
      ],
      "outputs": [
        "{workspaceRoot}/libs/go/gen",
        "{workspaceRoot}/libs/ts/gen",
        "{workspaceRoot}/api/proto/gen"
      ],
      "cache": true
    },
    "check-generated": {
      "executor": "nx:run-commands",
      "dependsOn": ["build:proto"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "git diff --exit-code -- libs/go/gen libs/ts/gen api/proto/gen"
      }
    }
  },
  "tags": ["lang:proto", "type:api"]
}

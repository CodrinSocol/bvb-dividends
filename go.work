// The Go workspace exists so the pinned build tools resolve from the repository
// root: `go tool buf`, `go tool sqlc`, `go tool golangci-lint` and the rest run
// with the root as their working directory, which is what every path in
// buf.gen.yaml, sqlc.yaml and the Nx targets assumes.
//
// The tools live in their own module so their (large) dependency graphs never
// end up in the application's go.mod.
go 1.26.3

use (
	.
	./tools
)
